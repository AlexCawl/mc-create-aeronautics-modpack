# Copy this file to .env to make modifications

# Required
MODRINTH_MODPACK=
RCON_PASSWORD=
RCON_WEB_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Minecraft
MC_PORT=25565
VOICE_CHAT_PORT=24454
MC_MEMORY=6G
MC_MOTD='Create Aeronautics'
ONLINE_MODE=false
ENABLE_RCON=true
USE_AIKAR_FLAGS=true
TZ=Asia/Yekaterinburg

# RCON web admin
RCON_WEB_VERSION=latest
RCON_WEB_PORT=4326
RCON_WEB_SOCKET_PORT=4327
RCON_WEB_USER=admin
RCON_WEB_SERVER_NAME='Create Aeronautics'

# Monitoring
MC_MONITOR_VERSION=latest
CADVISOR_VERSION=v0.47.1
PROMETHEUS_VERSION=latest
PROMETHEUS_RETENTION=7d
LOKI_VERSION=3.7.0
ALLOY_VERSION=latest
GRAFANA_VERSION=latest
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
